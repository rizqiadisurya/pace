# Wajib: kata sandi yang sama diisi di Pace → Profil → Sinkronisasi
SYNC_PASSPHRASE="ganti-dengan-kata-sandi-panjang"
# Asal (origin) aplikasi Pace yang boleh memanggil API ini
APP_ORIGIN="https://rizqiadisurya.github.io"
# URL halaman Pace untuk kembali setelah login Strava
APP_URL="https://rizqiadisurya.github.io/pace/profile/"

# Garmin Connect Personal API key (Garmin Connect Web → Settings → Personal API Key)
GARMIN_API_KEY=""
# connect.garmin.com → personal.connectapi.garmin.com ; akun China: personal.connectapi.garmin.cn
GARMIN_API_BASE="https://personal.connectapi.garmin.com"

# Strava (strava.com/settings/api). Authorization Callback Domain = domain Vercel API ini
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Basis API Strava (Strava mengumumkan https://api-v3.strava.com mulai 4 Jan 2027)
STRAVA_API_BASE="https://www.strava.com/api/v3"
